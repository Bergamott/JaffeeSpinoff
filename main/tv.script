TV_SPEED = 50.0
PATH_LENGTH = 1020.0
STOP1 = 200.0
STOP2 = 310.0
STOP3 = 400.0
STOP4 = 510.0
STOP5 = 710.0
STOP6 = 820.0
STOP7 = 910.0
STOP8 = PATH_LENGTH

function init(self)
	self.path_pos = 0.0
	self.pos = go.get_position()
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.path_pos = self.path_pos + dt * TV_SPEED
	if self.path_pos >= PATH_LENGTH then
		self.path_pos = self.path_pos - PATH_LENGTH
	end

	if self.path_pos >= 0 and self.path_pos < STOP1 then -- Top side
		self.pos.x = 372.0 - self.path_pos
		self.pos.y = 302.0
	elseif self.path_pos >= STOP1 and self.path_pos < STOP2 then -- NW corner
		self.pos.x = 172.0 - 70.0 * math.sin(math.pi * (self.path_pos - STOP1) / 220.0)
		self.pos.y = 232.0 + 70.0 * math.cos(math.pi * (self.path_pos - STOP1) / 220.0)
	elseif self.path_pos >= STOP2 and self.path_pos < STOP3 then -- Left side
		self.pos.x = 102.0
		self.pos.y = 233.0 - (self.path_pos - STOP2)
	elseif self.path_pos >= STOP3 and self.path_pos < STOP4 then -- SW corner
		self.pos.x = 172.0 - 70.0 * math.cos(math.pi * (self.path_pos - STOP3) / 220.0)
		self.pos.y = 142.0 - 70.0 * math.sin(math.pi * (self.path_pos - STOP3) / 220.0)
	elseif self.path_pos >= STOP4 and self.path_pos < STOP5 then -- Bottom side
		self.pos.x = 172.0 + (self.path_pos - STOP4)
		self.pos.y = 72.0
	elseif self.path_pos >= STOP5 and self.path_pos < STOP6 then -- SE corner
		self.pos.x = 372.0 + 70.0 * math.sin(math.pi * (self.path_pos - STOP5) / 220.0)
		self.pos.y = 142.0 - 70.0 * math.cos(math.pi * (self.path_pos - STOP5) / 220.0)
	elseif self.path_pos >= STOP6 and self.path_pos < STOP7 then -- Right side
		self.pos.x = 442.0
		self.pos.y = 143.0 + (self.path_pos - STOP6)
	elseif self.path_pos >= STOP7 and self.path_pos < STOP8 then -- SE corner
		self.pos.x = 372.0 + 70.0 * math.cos(math.pi * (self.path_pos - STOP7) / 220.0)
		self.pos.y = 232.0 + 70.0 * math.sin(math.pi * (self.path_pos - STOP7) / 220.0)
	end
	go.set_position(self.pos)
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("position") then
		print(message.path_pos)
		self.path_pos = message.path_pos
	end
end

