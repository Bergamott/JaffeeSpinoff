local group_data = require("main/group_data")

TV_URLS = {"/tv1#tv","/tv2#tv","/tv3#tv","/tv4#tv","/tv5#tv","/tv6#tv"}

ARROW_SPEED = 1.0
THROW_SPEED = 40.0

local function sign(v)
	return v > 0 and 1 or (v == 0 and 0 or -1)
end

local function setup_characters(self)
	for i=0,5 do
		local pos = vmath.vector3(260.0+48.0*((i%3)-1.0), 188.0+56.0*(0.5-math.floor(i/3)), 0.1)
		local id = factory.create("/game_area#character_factory", pos)
		table.insert(self.characters, id)
	end
	self.selected = 1
	msg.post(self.characters[self.selected], "activate")
	msg.post(".", "acquire_input_focus")
end

function init(self)
	-- Set up position tables for squircle
	local len = 0.0
	--local lastx = 272.0 + 170.0
	--local lasty = 188.0
	local lastx = 1.0
	local lasty = 0.0
		group_data.xpos[1] = lastx
	group_data.ypos[1] = lasty
	group_data.cumulative[1] = 0.0
	for i=1,128 do
		local p = i * math.pi / 64.0
		--local x = 272.0 + 170.0 * sign(math.cos(p)) * math.sqrt(math.abs(math.cos(p)))
		--local y = 188.0 + 115.0 * sign(math.sin(p)) * math.sqrt(math.abs(math.sin(p)))
		local x = sign(math.cos(p)) * math.sqrt(math.abs(math.cos(p)))
		local y = sign(math.sin(p)) * math.sqrt(math.abs(math.sin(p)))
		len = len + math.sqrt((x-lastx)*(x-lastx) + (y-lasty)*(y-lasty))
		group_data.xpos[i+1] = x
		group_data.ypos[i+1] = y
		group_data.cumulative[i+1] = len
		lastx = x
		lasty = y
	end
	group_data.length = len
	self.characters = {}
	self.selected = 0
	self.angle = 0
	setup_characters(self)

	self.state = 0
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if self.state == 0 then
		for i, tv_url in ipairs(TV_URLS) do
			msg.post(tv_url,"position", { path_pos = (i-1)*group_data.length / 6})
		end
		self.state = 1
	elseif self.state == 2 then
		self.angle = self.angle - dt * ARROW_SPEED
		if self.angle < 0 then
			self.angle = self.angle + 2*math.pi
		end
		go.set_rotation(vmath.quat_rotation_z(self.angle), "/arrow")
	end
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("missed") then
		self.selected = 1
		while self.selected < 7 and self.characters[self.selected] == 0 do
			self.selected = self.selected + 1
		end
		if self.selected < 7 then
			msg.post(self.characters[self.selected], "activate")
			self.state = 1
		else
			self.state = 4
		end

	end
end

function on_input(self, action_id, action)
	if self.state == 1 then
		if action_id == hash("left") and action.pressed then
			local sel = self.selected - 1
			if sel < 1 then
				sel = 6
			end
			while self.characters[sel] == 0 and sel ~= self.selected do
				sel = sel - 1
				if sel < 1 then
					sel = 6
				end
			end
			if sel ~= self.selected then
				msg.post(self.characters[self.selected], "deactivate")
				msg.post(self.characters[sel], "activate")
				self.selected = sel
			end
		elseif action_id == hash("fire") then
			self.state = 2
			local pos = go.get_position(self.characters[self.selected])
			pos.z = 0.2
			go.set_rotation(vmath.quat_rotation_z(0), "/arrow")
			go.set_position(pos, "/arrow")
		end
	elseif self.state == 2 then
		if action_id == hash("fire") and action.released then
			local pos = go.get_position("/arrow")
			go.set_position(vmath.vector3(-50.0, 0, 0), "/arrow")
			local impulse = vmath.rotate(vmath.quat_rotation_z(self.angle),
				vmath.vector3(THROW_SPEED, 0, 0))
			local id = factory.create("/game_area#fly_character_factory", pos,
				vmath.quat_rotation_z(self.angle-math.pi/2.0), {start_impulse = impulse})
			go.delete(self.characters[self.selected])
			self.characters[self.selected] = 0
			self.state = 3
		end
	end
end

